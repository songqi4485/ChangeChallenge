+"""Standalone voice WebSocket server entry point (T8).
+
+Wraps :func:`voice.websocket_server.serve_voice` with a fixed default
+loopback address (127.0.0.1:8765) and prints the actual listening endpoint
+and configuration snapshot so clients can connect. ``--host``/``--port`` are
+configurable; binding a non-loopback host requires the explicit opt-in flag
+because it exposes the server to the network. No WebSocket protocol logic is
+reimplemented here.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+from pathlib import Path
+import sys
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+SRC_DIR = PROJECT_ROOT / "src"
+if str(SRC_DIR) not in sys.path:
+    sys.path.insert(0, str(SRC_DIR))
+
+from voice.settings import VoiceSettings
+from voice.websocket_server import serve_voice
+
+CONFIG_PATH = PROJECT_ROOT / "configs" / "voice.yaml"
+
+LOOPBACK_HOSTS = {"127.0.0.1", "localhost", "::1"}
+
+# P1-4: the full pipeline (whisper small/int8 CPU transcription + bge_m3
+# embedding + DeepSeek generation with a 60s provider timeout) can run for
+# well over 30 seconds with the client sending nothing. The production
+# entry point therefore defaults to an idle budget that covers the worst
+# single inference step plus margin, instead of the library default of 30s.
+DEFAULT_IDLE_TIMEOUT_SECONDS = 120.0
+
+
+async def prewarm_asr(settings: VoiceSettings) -> None:
+    """Load the ASR model BEFORE the server starts listening (VR7-T17).
+
+    No-op unless ``asr_config.prewarm`` is truthy.
+    """
+    asr_config = settings.asr_config or {}
+    if not asr_config.get("prewarm"):
+        return
+    if settings.asr_provider == "whisper":
+        from voice.whisper_asr import WhisperASRProvider
+
+        provider = WhisperASRProvider(settings=settings)
+        await provider.prewarm()
+    elif settings.asr_provider == "qwen3_asr":
+        from voice.qwen_asr import QwenASRProvider
+
+        provider = QwenASRProvider(settings=settings)
+        await provider.prewarm()async def check_tts_ready(settings: VoiceSettings) -> None:    """Log a non-blocking readiness check when tts_provider is cosyvoice."""    if settings.tts_provider != "cosyvoice":        return    import httpx    endpoint = str((settings.tts_config or {}).get("endpoint") or "http://127.0.0.1:50000").rstrip("/")    try:        async with httpx.AsyncClient(timeout=2.0) as client:            resp = await client.get(f"{endpoint}/health")            if resp.status_code == 200 and resp.json().get("ready") is True:                return    except Exception:        pass    print(f"[提示] CosyVoice 服务 ({endpoint}) 尚未就绪，语音播报将自动降级保留文字回答。")
+
+
+async def main() -> None:
+    parser = argparse.ArgumentParser(description="翼览无余 语音 WebSocket 服务")
+    parser.add_argument("--host", default="127.0.0.1")
+    parser.add_argument("--port", type=int, default=8765)
+    parser.add_argument(
+        "--idle-timeout",
+        type=float,
+        default=DEFAULT_IDLE_TIMEOUT_SECONDS,
+        help="无流量（双向）空闲超时秒数（默认 %(default)s，须覆盖最长单步推理）",
+    )
+    parser.add_argument(
+        "--processing-heartbeat",
+        type=float,
+        default=15.0,
+        help="turn 计算期间刷新活动时钟的心跳间隔秒数（默认 %(default)s，0 为非法）",
+    )
+    parser.add_argument(
+        "--max-processing",
+        type=float,
+        default=300.0,
+        help="单个 turn 的最大处理预算秒数（默认 %(default)s），超预算后停发心跳并放行空闲超时兜底",
+    )
+    args = parser.parse_args()
+
+    settings = VoiceSettings.from_file(CONFIG_PATH)
+    await prewarm_asr(settings)    await check_tts_ready(settings)
+    server = await serve_voice(
+        host=args.host,
+        port=args.port,
+        settings=settings,
+        allow_non_loopback=(args.host not in LOOPBACK_HOSTS),
+        idle_timeout_seconds=args.idle_timeout,
+        processing_heartbeat_seconds=args.processing_heartbeat,
+        max_processing_seconds=args.max_processing,
+    )
+    if args.host not in LOOPBACK_HOSTS:
+        print(
+            f"[警告] 已允许非回环监听（{args.host}），请确认网络边界与防火墙"
+        )
+    try:
+        port = int(server.sockets[0].getsockname()[1])
+        print(f"WS 地址: ws://{args.host}:{port}")
+        print(f"健康检查: http://{args.host}:{port}/health")
+        print(f"配置快照 ID: {settings.snapshot_id}")
+        sys.stdout.flush()
+        await server.wait_closed()
+    finally:
+        server.close()
+
+
+if __name__ == "__main__":
+    asyncio.run(main())
